# --- Contact form (server-only, never prefix with NEXT_PUBLIC_) ---
# Gmail for testing: smtp.gmail.com / 587, SMTP_PASS = 16-char app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Sahathai Website

# Recipients per form type; any left empty falls back to CONTACT_TO_DEFAULT
CONTACT_TO_DEFAULT=
CONTACT_TO_CONTACT=
CONTACT_TO_COMPLAINT=
CONTACT_TO_IR=
CONTACT_TO_SECRETARY=

# Optional: save submissions to Strapi (API token with create + update on contact-submission)
STRAPI_CONTACT_TOKEN=

# Optional: rate limit via Upstash Redis (set automatically by the Vercel integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=
